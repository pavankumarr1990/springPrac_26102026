    JOIN employee e ON e.email = v.email
    WHERE NOT EXISTS (
        SELECT 1
        FROM leave_request lr
        WHERE lr.employee_id = e.employee_id
          AND lr.start_date = v.start_date
          AND lr.leave_type = v.leave_type
    );
    =======================================
    SELECT 'department' AS table_name, COUNT(*) AS total_records
    FROM employee_management.department

    UNION ALL

    SELECT 'employee', COUNT(*)
    FROM employee_management.employee

    UNION ALL

    SELECT 'employee_address', COUNT(*)
    FROM employee_management.employee_address

    UNION ALL

    SELECT 'employee_salary', COUNT(*)
    FROM employee_management.employee_salary

    UNION ALL

    SELECT 'attendance', COUNT(*)
    FROM employee_management.attendance

    UNION ALL

    SELECT 'leave_request', COUNT(*)
    FROM employee_management.leave_request

    ORDER BY table_name;